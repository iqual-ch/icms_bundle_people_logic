<?php

/**
 * @file
 * Update hooks for ICMS People bundle.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Symfony\Component\Yaml\Yaml;

/**
 * Implements hook_install().
 *
 * Sets the module weight to 50 to ensure deployment hooks run in the
 * correct order after core modules.
 */
function icms_bundle_people_logic_install() {
  module_set_weight('icms_bundle_people_logic', 50);

  // Import default bundle texts on module installation.
  icms_bundle_people_logic_import_default_texts();
}

/**
 * Add the sorting option to people listings (ICMS-584).
 */
function icms_bundle_people_logic_update_11002() {
  $messages = [];
  // Fields the project exports are created from the export, keeping their
  // UUIDs (ICMS-816). The service comes with icms_core_logic, which this
  // module does not depend on.
  /** @var \Drupal\icms_core_logic\UpdateConfigInstaller|null $installer */
  $installer = \Drupal::hasService('icms_core_logic.update_config_installer') ? \Drupal::service('icms_core_logic.update_config_installer') : NULL;

  // Field storage for the sorting option.
  if (!FieldStorageConfig::loadByName('paragraph', 'field_icms_sorting')) {
    if (!$installer?->importConfigEntity('field.storage.paragraph.field_icms_sorting')) {
      FieldStorageConfig::create([
        'field_name' => 'field_icms_sorting',
        'entity_type' => 'paragraph',
        'type' => 'list_string',
        'settings' => [
          'allowed_values' => [
            'default' => 'Default (newest first)',
            'alphabetical' => 'Alphabetical (A-Z)',
            'weight' => 'Weight',
          ],
          'allowed_values_function' => '',
        ],
        'cardinality' => 1,
        'translatable' => FALSE,
      ])->save();
    }
    $messages[] = 'Created field_icms_sorting storage.';
  }

  // Field instance on the people listing paragraph.
  if (!FieldConfig::loadByName('paragraph', 'icms_layout_people', 'field_icms_sorting')) {
    if (!$installer?->importConfigEntity('field.field.paragraph.icms_layout_people.field_icms_sorting')) {
      FieldConfig::create([
        'field_name' => 'field_icms_sorting',
        'entity_type' => 'paragraph',
        'bundle' => 'icms_layout_people',
        'label' => 'Sorting',
        'description' => '<strong>Default:</strong> Sorted by weight, then newest first (publication date).<br /><strong>Alphabetical:</strong> Sorted by last name (A-Z).<br /><strong>Weight:</strong> Sorted by the sort order field only; higher values are shown first.',
        'required' => TRUE,
        'default_value' => [['value' => 'default']],
      ])->save();
    }
    $messages[] = 'Created field_icms_sorting on icms_layout_people.';
  }

  // Show the field on the form. Loaded without translations: in drush, load()
  // applies the default language's config translation, and saving that writes
  // it into the base config (ICMS-839).
  $form_display = \Drupal::entityTypeManager()->getStorage('entity_form_display')->loadOverrideFree('paragraph.icms_layout_people.default');
  if ($form_display && !$form_display->getComponent('field_icms_sorting')) {
    $form_display->setComponent('field_icms_sorting', [
      'type' => 'options_select',
      'weight' => 13,
      'region' => 'content',
    ])->save();
    $messages[] = 'Added field_icms_sorting to the form display.';
  }

  // Expose the field in the GraphQL schema.
  $graphql = \Drupal::configFactory()->getEditable('graphql.graphql_servers.graphql');
  if (!$graphql->isNew() && !$graphql->get('schema_configuration.core_composable.fields.paragraph.field_icms_sorting')) {
    $graphql->set('schema_configuration.core_composable.fields.paragraph.field_icms_sorting', 'field_icms_sorting')->save();
    $messages[] = 'Enabled field_icms_sorting in the GraphQL schema.';
  }

  // Index the last name so listings can sort alphabetically.
  $index_config = \Drupal::configFactory()->getEditable('search_api.index.content_search');
  if (!$index_config->isNew() && !$index_config->get('field_settings.lastname')) {
    $index_config->set('field_settings.lastname', [
      'label' => 'Last name',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_icms_people_lastname',
      'type' => 'string',
      'dependencies' => [
        'config' => ['field.storage.node.field_icms_people_lastname'],
      ],
    ])->save();
    $messages[] = 'Added lastname to the content_search index.';

    $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('content_search');
    if ($index) {
      $index->reindex();
      $messages[] = 'Queued content_search for reindexing.';
    }
  }

  return implode(' ', $messages) ?: (string) new TranslatableMarkup('Nothing to do.');
}

/**
 * Imports the missing default texts from the package-local texts file.
 *
 * Existing texts are left unchanged, so update hooks can call this to add new
 * entries without resetting what editors changed. Languages the site lacks or
 * has locked are skipped.
 *
 * @throws \RuntimeException
 *   When the texts file is invalid or a text cannot be imported.
 */
function icms_bundle_people_logic_import_default_texts(): void {
  $module_name = 'icms_bundle_people_logic';
  $module_handler = \Drupal::moduleHandler();

  if (!$module_handler->moduleExists('texts') || !$module_handler->moduleExists('texts_sync')) {
    \Drupal::logger($module_name)->notice('Skipped texts import during install because texts/texts_sync is not enabled.');
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath($module_name);
  $texts_file = DRUPAL_ROOT . '/' . $module_path . '/texts/texts.yml';

  if (!is_readable($texts_file)) {
    \Drupal::logger($module_name)->notice('Skipped texts import during install because no readable texts file was found at @path.', ['@path' => $texts_file]);
    return;
  }

  $data = Yaml::parseFile($texts_file);
  if (!is_array($data) || empty($data)) {
    throw new \RuntimeException(sprintf('The default texts file is empty or invalid: %s', $texts_file));
  }

  // Only missing texts are created: an existing text keeps the wording
  // editors gave it, in every language.
  /** @var \Drupal\texts_sync\TextsSyncService $texts_sync */
  $texts_sync = \Drupal::service('texts_sync.service');
  $stats = $texts_sync->import($data, NULL, FALSE);

  $logger = \Drupal::logger($module_name);
  $logger->notice('Imported default texts. Created: @created, kept existing: @skipped, failed: @failed.', [
    '@created' => $stats['created'],
    '@skipped' => $stats['skipped'],
    '@failed' => $stats['failed'],
  ]);
  foreach ($stats['errors'] as $message) {
    if (!str_contains($message, 'already exists')) {
      $logger->warning($message);
    }
  }

  if ($stats['failed'] > 0) {
    throw new \RuntimeException(sprintf('Failed to import %d default texts: %s', $stats['failed'], implode(' ', preg_grep('/^Failed to import/', $stats['errors']))));
  }
}

/**
 * Let editors choose the original language of people.
 *
 * Mirrors the recipe: the language selector is enabled for the content type
 * and placed above the form tabs. The shared helper lives in icms_core_logic,
 * which every ICMS site has installed.
 */
function icms_bundle_people_logic_update_11003() {
  \Drupal::moduleHandler()->loadInclude('icms_core_logic', 'install');
  if (!function_exists('_icms_core_logic_enable_original_language_selection')) {
    return (string) new TranslatableMarkup('Skipped: icms_core_logic is missing the language selection helper, update it first.');
  }

  $messages = _icms_core_logic_enable_original_language_selection('node', 'icms_people');
  if (!$messages) {
    return (string) new TranslatableMarkup('The original language of people was already selectable.');
  }
  return implode(' ', $messages);
}

/**
 * Import the missing people texts, such as the "Listed only" notice (ICMS-862).
 *
 * Without them the first frontend request creates each text in the site's
 * default language with its English fallback.
 */
function icms_bundle_people_logic_update_11004() {
  icms_bundle_people_logic_import_default_texts();

  return (string) new TranslatableMarkup('Imported the missing people bundle texts. Existing texts are unchanged.');
}
